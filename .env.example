# Local-only example credentials for the isolated Docker database.
DATABASE_URL=postgresql://onramp:onramp_local@127.0.0.1:55432/onramp

# Optional LLM extraction (configure the source model with pnpm ingest config).
# CLOUDFLARE_ACCOUNT_ID=
# AI_GATEWAY_ID=
# CLOUDFLARE_AI_TOKEN=
# AI_GATEWAY_SPEND_LIMIT_CONFIGURED=true
# Optional override; conversational discovery defaults to Cloudflare-hosted
# @cf/ibm-granite/granite-4.0-h-micro once the Gateway is configured.
# DISCOVERY_MODEL=
# INGEST_SNAPSHOT_DIR=.data/ingestion

# Tagging pilot: Vercel AI SDK with OpenAI credits through Cloudflare BYOK.
# Keep real keys in the ignored .env file, never in tracked configuration.
# OPENAI_API_KEY=
# TAGGING_PROVIDER=openai
# TAGGING_MODEL=gpt-4.1-mini
# Gateway settings above are also required; the token must permit Gateway runs.
# Switch to TAGGING_PROVIDER=cloudflare and a supported @cf/... model to use Workers AI.

# Ingestion tagging: rules without Gateway config, hybrid when Gateway is configured.
# Set hybrid to require inference configuration; deterministic explicitly uses rules.
# INGEST_TAGGING_MODE=deterministic
