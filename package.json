{
  "name": "on-ramp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx scripts/test-db.ts",
    "test:browser": "node --import tsx scripts/test-browser.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:seed:demo": "node --import tsx scripts/demo-data.ts seed",
    "db:clean:demo": "node --import tsx scripts/demo-data.ts clean",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "ingest": "node --import tsx scripts/ingest.ts",
    "tagging": "node --import tsx scripts/tagging.ts",
    "deploy": "pnpm build && wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.121",
    "@ai-sdk/openai-compatible": "3.0.93",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "ai": "7.0.177",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.75.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.69.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "node": "22.23.5",
    "playwright": "1.65.0",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.161.0"
  },
  "packageManager": "pnpm@10.34.4"
}
